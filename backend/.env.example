# Server Configuration
PORT=5000
NODE_ENV=development
LOG_LEVEL=info

# Database
MONGODB_URI=mongodb://localhost:27017/wrapskinwise

# Redis
REDIS_URL=redis://localhost:6379

# Firebase Admin
FIREBASE_SERVICE_ACCOUNT_PATH=./config/firebase-service-account.json

# S3 / DigitalOcean Spaces (Image Storage)
S3_ACCESS_KEY_ID=your_do_spaces_key
S3_SECRET_ACCESS_KEY=your_do_spaces_secret
S3_REGION=nyc3
S3_BUCKET_NAME=your_space_name
S3_ENDPOINT=https://nyc3.digitaloceanspaces.com

# Services
PYTHON_SERVICE_URL=http://localhost:7000
SR_SERVICE_URL=http://localhost:7001

# Anthropic (for Routine Generation)
ANTHROPIC_API_KEY=

# Security
JWT_SECRET=
